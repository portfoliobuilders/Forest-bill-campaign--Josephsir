NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Replace re_xxxxxxxxx with your real Resend API key from https://resend.com/api-keys
# Never prefix this with NEXT_PUBLIC_ — it must stay server-side only.
RESEND_API_KEY=re_xxxxxxxxx
# Verified sender, e.g. Janashabdam <noreply@janashabdam.in>
# Leave empty to use Resend's test sender onboarding@resend.dev
RESEND_FROM_EMAIL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
IP_HASH_SALT=
# Comma-separated allowlist. Compared after trim + lowercase. Never commit real addresses.
ADMIN_EMAILS=
# Must match the deployed origin (magic-link redirect). Example: https://forest-bill-campaign-josephsir.vercel.app
# Also set this same URL as the Supabase Auth Site URL, and add:
#   {SITE_URL}/auth/callback
#   {SITE_URL}/admin/auth/callback
# to Supabase Auth Redirect URLs. Admin login emails prefer RESEND_API_KEY + RESEND_FROM_EMAIL.
NEXT_PUBLIC_SITE_URL=
CAMPAIGN_SLUG=kerala-forest-amendment-2024
