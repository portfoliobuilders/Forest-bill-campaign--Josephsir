NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Replace re_xxxxxxxxx with your real Resend API key from https://resend.com/api-keys
# Never prefix this with NEXT_PUBLIC_ — it must stay server-side only.
RESEND_API_KEY=re_xxxxxxxxx
# Verified sender, e.g. Janashabdam <noreply@janashabdam.in>
# Leave empty to use Resend's test sender onboarding@resend.dev
RESEND_FROM_EMAIL=
IP_HASH_SALT=
# Comma-separated allowlist. Compared after trim + lowercase. Never commit real addresses.
ADMIN_EMAILS=
# Optional override for emergency admin password login. Leave empty in git. Set on Vercel to rotate.
ADMIN_PASSWORD=
# Must match the deployed origin (magic-link redirect). Example: https://forest-bill-campaign-josephsir.vercel.app
# Also set this same URL as the Supabase Auth Site URL, and add:
#   {SITE_URL}/auth/callback
#   {SITE_URL}/admin/auth/callback
# to Supabase Auth Redirect URLs. Admin login emails prefer RESEND_API_KEY + RESEND_FROM_EMAIL.
NEXT_PUBLIC_SITE_URL=
# Homepage now shows the active campaign from the database. CAMPAIGN_SLUG is unused
# for the public homepage; keep it empty unless an older admin helper needs a default.
CAMPAIGN_SLUG=

# Optional PIN lookup fallback. Default is https://api.postalpincode.in/pincode/{pin}
# Local Supabase postal_directory is always tried first.
PINCODE_FALLBACK_URL=

# Optional Government of India data.gov.in All India Pincode Directory (secondary fallback).
# Resource id defaults to 6176ee09-3d56-4a3b-8115-21841576b2f6
DATA_GOV_API_KEY=
DATA_GOV_PINCODE_RESOURCE=

# Optional AI mail improvement. Server-side only — never prefix with NEXT_PUBLIC_ or VITE_.
# Leave empty to keep AI off. Public sending still works from local templates.
# AI_PROVIDER=disabled | gemini | local
AI_PROVIDER=
AI_MODEL=gemini-2.5-flash
AI_API_KEY=
# GEMINI_API_KEY is accepted as an alias of AI_API_KEY
GEMINI_API_KEY=
